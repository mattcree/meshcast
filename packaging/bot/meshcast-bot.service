# systemd unit for the Meshcast Discord bot.
# Installed by scripts/deploy-bot.sh — paths below are substituted at install time.
#
#   System service: /etc/systemd/system/meshcast-bot.service
#   User service:   ~/.config/systemd/user/meshcast-bot.service

[Unit]
Description=Meshcast Discord Bot
Documentation=https://github.com/mattcree/meshcast
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Contains DISCORD_TOKEN=... (mode 0600)
EnvironmentFile=@ENV_FILE@
Environment=RUST_LOG=meshcast_bot=info,iroh=warn
ExecStart=@BIN@
Restart=always
RestartSec=10
@USER_LINE@
# Hardening (harmless for the bot: it only needs network + its state dir)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=@PROTECT_HOME@
ReadWritePaths=@STATE_DIR@

[Install]
WantedBy=@WANTED_BY@
